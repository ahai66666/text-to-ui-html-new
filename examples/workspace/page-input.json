{
  "schemaVersion": 1,
  "id": "workspace",
  "title": "文件工具",
  "task": "file-manager",
  "user": "桌面用户",
  "workObject": "页面偏好",
  "primaryJob": "查看设置并切换提示",
  "entities": [
    {
      "id": "preference",
      "fields": [
        "name",
        "value"
      ]
    }
  ],
  "groups": [
    {
      "id": "navigation",
      "region": "primary-navigation",
      "purpose": "设置导航",
      "children": [
        {
          "id": "nav",
          "use": "primary-navigation-item",
          "context": "primary-navigation-shell",
          "options": {
            "label": "文件工具",
            "icon": "action/settings",
            "selected": true
          },
          "behavior": "navigate"
        }
      ]
    },
    {
      "id": "content-0",
      "region": "tool-workspace",
      "purpose": "记录列表",
      "composition": "search-toolbar",
      "children": [
        {
          "id": "toggle",
          "use": "toolbar-icon-text-action",
          "context": "toolbar-action",
          "options": {
            "label": "切换提示",
            "icon": "action/settings"
          },
          "behavior": "toggle-status",
          "slot": "workspace-toolbar"
        },
        {
          "id": "status",
          "text": "示例记录"
        }
      ]
    }
  ],
  "interactions": [
    {
      "id": "navigate",
      "kind": "component-native",
      "triggers": [
        "nav"
      ],
      "outcome": "选择设置导航"
    },
    {
      "id": "toggle-status",
      "kind": "toggle-hidden",
      "sourceGroup": "content-0",
      "triggers": [
        "toggle"
      ],
      "targetSelector": "[data-composition-id=\"status\"]",
      "outcome": "切换提示显示"
    }
  ],
  "successCriteria": [
    "切换提示按钮可隐藏和显示提示"
  ],
  "recoveryPaths": [
    "重新打开页面恢复初始状态"
  ],
  "pattern": "pattern-c-tool-workspace",
  "patternReason": "展示当前任务允许的布局"
}