{
  "schemaVersion": 1,
  "id": "inspector",
  "title": "记录检查器",
  "task": "记录管理",
  "user": "桌面用户",
  "workObject": "页面偏好",
  "primaryJob": "查看设置并切换提示",
  "entities": [
    {
      "id": "preference",
      "fields": [
        "name",
        "value"
      ]
    }
  ],
  "groups": [
    {
      "id": "content-0",
      "region": "secondary-or-canvas",
      "purpose": "记录列表",
      "composition": "search-toolbar",
      "children": [
        {
          "id": "toggle",
          "use": "button",
          "context": "page-primary-action",
          "options": {
            "label": "切换提示"
          },
          "behavior": "toggle-status"
        },
        {
          "id": "status",
          "text": "示例记录"
        }
      ]
    },
    {
      "id": "content-1",
      "region": "main-content",
      "purpose": "记录信息",
      "composition": "field-group",
      "children": [
        {
          "id": "info-1",
          "text": "用户提供的信息"
        },
        {
          "id": "inspector-toggle",
          "use": "toolbar-icon-action",
          "context": "toolbar-action",
          "options": {
            "label": "切换检查器",
            "icon": "action/settings"
          },
          "slot": "inspector-toggle",
          "behavior": "toggle-inspector"
        }
      ]
    },
    {
      "id": "content-2",
      "region": "inspector",
      "purpose": "记录信息",
      "composition": "field-group",
      "children": [
        {
          "id": "info-2",
          "text": "用户提供的信息"
        }
      ]
    }
  ],
  "interactions": [
    {
      "id": "toggle-status",
      "kind": "toggle-hidden",
      "sourceGroup": "content-0",
      "triggers": [
        "toggle"
      ],
      "targetSelector": "[data-composition-id=\"status\"]",
      "outcome": "切换提示显示"
    },
    {
      "id": "toggle-inspector",
      "kind": "toggle-hidden",
      "triggers": [
        "inspector-toggle"
      ],
      "targetSelector": "[data-pattern-region=\"inspector\"]",
      "outcome": "显示或隐藏检查器"
    }
  ],
  "successCriteria": [
    "切换提示按钮可隐藏和显示提示"
  ],
  "recoveryPaths": [
    "重新打开页面恢复初始状态"
  ],
  "pattern": "pattern-d-inspector",
  "patternReason": "展示当前任务允许的布局",
  "patternBase": "pattern-b-three-pane"
}
